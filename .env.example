# ---------------------------------------------------------------------------
# DevTrack environment configuration
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` and `.env*` are git-ignored and must never be committed.
#
# Every variable prefixed with VITE_ is embedded in the client bundle and is
# therefore PUBLIC. Only ship values that are safe to expose in a browser.
# ---------------------------------------------------------------------------

# --- Firebase Web App configuration ---------------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup
# These are public client identifiers. Access is enforced by Firestore and
# Storage security rules + Firebase Authentication, not by hiding this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed if you enabled Google Analytics on the project.
VITE_FIREBASE_MEASUREMENT_ID=

# --- GitHub (public REST API, no token required) ---------------------------
# Optional default username pre-filled on the GitHub page.
VITE_GITHUB_USERNAME=

# Optional server-side proxy URL (e.g. a Cloud Function you deployed) that
# forwards GitHub requests using a private token held in the server
# environment. Leave empty to call api.github.com directly (60 req/hour/IP).
# The URL itself is public; the GITHUB_TOKEN must only exist server-side.
VITE_GITHUB_PROXY_URL=

# --- Site links (optional) -------------------------------------------------
# Footer and landing page only render these links when they are provided,
# so no placeholder/dead URLs are shipped.
VITE_SITE_GITHUB_URL=
VITE_SITE_LINKEDIN_URL=
VITE_SITE_X_URL=
